{
  "manifest_version": 3,
  "name": "SuiYuan Search",
  "version": "2.0.0",
  "description": "随缘搜索 — 简洁的浏览器起始页，多引擎搜索、自定义捷径、壁纸与时钟",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://api.bimg.cc/*",
    "https://suggestion.baidu.com/*"
  ],
  "icons": {
    "16": "img/ico.ico",
    "48": "img/ico.ico",
    "128": "img/ico.ico"
  },
  "action": {
    "default_title": "打开随缘搜索"
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "key": ""
}
