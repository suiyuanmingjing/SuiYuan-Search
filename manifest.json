{
  "manifest_version": 3,
  "name": "随缘搜索 - SuiYuan Search",
  "version": "2.1.0",
  "description": "简洁的新标签页：大时钟、胶囊搜索、壁纸库、必应每日、多语言界面",
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "https://api.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://api.bimg.cc/*",
    "https://suggestion.baidu.com/*"
  ],
  "icons": {
    "16": "img/icon-16.png",
    "32": "img/icon-32.png",
    "48": "img/icon-48.png",
    "128": "img/icon-128.png"
  },
  "action": {
    "default_title": "打开随缘搜索",
    "default_icon": {
      "16": "img/icon-16.png",
      "32": "img/icon-32.png",
      "48": "img/icon-48.png",
      "128": "img/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "homepage_url": "https://github.com/suiyuanmingjing/SuiYuan-Search"
}
